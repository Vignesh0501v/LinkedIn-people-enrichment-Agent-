REDIS_URL=redis://localhost:6379
# Chat session/turn history (Plan unit #23). Point this at the Postgres
# docker-compose publishes on 5433, or at a file-backed SQLite database
# (e.g. sqlite:///./chat.db) to run the API with no database server at all.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/linkedin_enrichment
GROQ_API_KEY=
TAVILY_API_KEY=
